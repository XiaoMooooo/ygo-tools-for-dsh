{
  "name": "ygo-tools-for-dsh",
  "version": "1.2.2",
  "description": "Native DeepSeek Harness tools for Yu-Gi-Oh card research, deck analysis, verified duel simulation, replay analysis, and YGOPro2 bridging.",
  "private": true,
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoMooooo/ygo-tools-for-dsh.git"
  },
  "homepage": "https://github.com/XiaoMooooo/ygo-tools-for-dsh#readme",
  "bugs": {
    "url": "https://github.com/XiaoMooooo/ygo-tools-for-dsh/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "!skill/vendor/node_modules/**/*.d.ts",
    "!skill/vendor/node_modules/**/*.map",
    "!skill/vendor/node_modules/**/*.md",
    "skill/vendor/node_modules/**/LICENSE.md",
    "skill/vendor/node_modules/**/license.md",
    "!skill/vendor/node_modules/@types/**",
    "!skill/resources/ygopro2-bridge/windbot/source/**"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "test": "node tests/contract.test.mjs && node tests/write-policy.test.mjs && node tests/search-order.test.mjs && node tests/engine-host.test.mjs && node tests/packaging.test.mjs"
  },
  "keywords": [
    "yugioh",
    "ygopro",
    "game-ai",
    "dsh",
    "deepseek-harness",
    "cordis",
    "ocgcore"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "plugin": {
      "id": "ygo-tools",
      "kind": "tool-set",
      "row": {
        "id": "ygo-tools",
        "name": "ygo-tools-for-dsh"
      }
    }
  }
}
